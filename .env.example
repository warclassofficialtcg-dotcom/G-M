# G & M - configurazione incassi (copia questo file in .env e compila)

# 'stripe' per incassare davvero, 'simulated' per provare senza addebiti
PAYMENTS_PROVIDER=simulated

# --- STRIPE (dashboard.stripe.com -> Developers -> API keys) ---
# Chiave segreta: sk_live_... (o sk_test_... per le prove). Copiala INTERA col pulsante di copia.
STRIPE_SECRET_KEY=
# Chiave pubblicabile: pk_live_... / pk_test_...
STRIPE_PUBLISHABLE_KEY=

# Segreto del webhook (whsec_...). Senza, il pacchetto si attiva solo quando il
# cliente torna sull'app dopo il pagamento (e dal recupero periodico in Gestione -> Pagamenti).
#   1. dashboard.stripe.com -> Developers -> Webhooks -> Add endpoint
#   2. URL: <PUBLIC_URL>/api/payments/stripe-webhook
#   3. Evento: checkout.session.completed
#   4. Signing secret -> Reveal -> incolla qui
STRIPE_WEBHOOK_SECRET=

# URL pubblico dell'app (dove Stripe riporta il cliente). Se vuoto usa BASE_URL di config.json.
PUBLIC_URL=

# IVA (0.22 = 22%); i prezzi del listino sono IVA inclusa
VAT_RATE=0.22
